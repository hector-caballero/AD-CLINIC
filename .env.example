# Plantilla de variables de entorno de AD Clinic
# Uso: copia este archivo como `.env` (o `.env.local`) y completa los valores reales.
# Los archivos `.env` / `.env.local` están en .gitignore: nunca subas credenciales al repo.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> Data API -> Project URL
# Ejemplo: https://abcdefghijklmnopqrst.supabase.co
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jzorihtaauuskaijwfkp.supabase.co

# Dashboard -> Project Settings -> API Keys -> `anon` / `public`
# Esta clave viaja al navegador (es pública por diseño).
# NUNCA pongas aquí la `service_role` key: expone toda la base de datos.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6b3JpaHRhYXV1c2thaWp3ZmtwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMxNTQ3MjgsImV4cCI6MjEwODczMDcyOH0.ZhsuasQo2N9FZcGaYv6nUQXbh3NBXy1MhlbkF9iCblg

# ---------------------------------------------------------------------------
# Evolution API (recordatorios de WhatsApp)
# Instancia ya conectada al WhatsApp de la clínica en el VPS.
# URL base sin `/` final. La `apikey` es la global de Evolution (`AUTHENTICATION_API_KEY`).
# `VITE_EVOLUTION_INSTANCE` es el nombre de la instancia conectada (`ad-clinic`).
#
# Tiene que ser HTTPS si la app se publica por HTTPS: el navegador bloquea las
# llamadas desde una página HTTPS a `http://…` (contenido mixto). En el VPS:
#   cloudflared tunnel --url http://localhost:8080
# imprime un hostname `https://<palabras>.trycloudflare.com` que se pega aquí.
# Ese túnel rápido cambia de URL al reiniciarse: para producción, usá un named
# tunnel con subdominio propio o nginx/Caddy con certificado.
#
# Completá los valores reales en tu `.env` local: este archivo se versiona y no
# debe llevar credenciales. La `apikey` de Evolution permite enviar mensajes en
# nombre de la clínica, así que tratála como un secreto (generá una exclusiva
# para la app y no reutilices la del panel de Evolution).
# Si el VPS usa CORS restrictivo, agregá el dominio de la clínica en `CORS_ORIGIN`.
# ---------------------------------------------------------------------------
VITE_EVOLUTION_API_URL=https://tu-subdominio.trycloudflare.com
VITE_EVOLUTION_API_KEY=tu_apikey_de_evolution
VITE_EVOLUTION_INSTANCE=ad-clinic

# ---------------------------------------------------------------------------
# Webhook de respuestas del paciente (Edge Function `whatsapp-webhook`)
# NO lleva prefijo VITE_: es un secreto de servidor y Vite solo inyecta en el
# bundle las variables `VITE_*`, así que este valor nunca llega al navegador.
#
# Secreto compartido entre Evolution API (header `x-webhook-secret` del webhook
# de la instancia) y la Edge Function (`supabase secrets set`). Mínimo 24
# caracteres; generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser el MISMO valor en este `.env`, en los secretos de Supabase y en el
# webhook de Evolution. Si cambia, hay que repetir los tres pasos.
# ---------------------------------------------------------------------------
WHATSAPP_WEBHOOK_SECRET=pega_aqui_un_secreto_de_64_caracteres_hexadecimales

# ---------------------------------------------------------------------------
# Gemini (dictado asistido de la historia clínica / anamnesis)
# Google AI Studio -> "Get API key". La clave viaja en el bundle del navegador
# porque Vite solo inyecta las variables `VITE_*`: restringila en Google Cloud
# (API key restrictions -> HTTP referrers) al dominio de la clínica y dejala
# habilitada solo para la "Generative Language API".
#
# Si falta la clave, la ficha sigue funcionando a mano: el panel de dictado
# muestra un aviso y desactiva el botón «Dictar con IA».
#
# `VITE_GEMINI_MODEL` es opcional (por defecto `gemini-flash-latest`). Si el
# modelo configurado no existe, la app prueba automáticamente con
# `gemini-2.5-flash` y `gemini-1.5-flash`.
# ---------------------------------------------------------------------------
VITE_GEMINI_API_KEY=tu_api_key_de_google_ai_studio
VITE_GEMINI_MODEL=gemini-flash-latest

