# Plantilla de variables de entorno de AD Clinic
# Uso: copia este archivo como `.env` (o `.env.local`) y completa los valores reales.
# Los archivos `.env` / `.env.local` están en .gitignore: nunca subas credenciales al repo.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> Data API -> Project URL
# Ejemplo: https://abcdefghijklmnopqrst.supabase.co
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jzorihtaauuskaijwfkp.supabase.co

# Dashboard -> Project Settings -> API Keys -> `anon` / `public`
# Esta clave viaja al navegador (es pública por diseño).
# NUNCA pongas aquí la `service_role` key: expone toda la base de datos.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6b3JpaHRhYXV1c2thaWp3ZmtwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMxNTQ3MjgsImV4cCI6MjEwODczMDcyOH0.ZhsuasQo2N9FZcGaYv6nUQXbh3NBXy1MhlbkF9iCblg

# ---------------------------------------------------------------------------
# Evolution API (recordatorios de WhatsApp)
# Instancia ya conectada al WhatsApp de la clínica en el VPS.
# URL base sin `/` final. La `apikey` es la global de Evolution (`AUTHENTICATION_API_KEY`).
# `VITE_EVOLUTION_INSTANCE` es el nombre de la instancia conectada (`ad-clinic`).
#
# Completá los valores reales en tu `.env` local: este archivo se versiona y no
# debe llevar credenciales. La `apikey` de Evolution permite enviar mensajes en
# nombre de la clínica, así que tratála como un secreto (generá una exclusiva
# para la app y no reutilices la del panel de Evolution).
# Si el VPS usa CORS restrictivo, agregá el dominio de la clínica en `CORS_ORIGIN`.
# ---------------------------------------------------------------------------
VITE_EVOLUTION_API_URL=http://TU_IP_O_DOMINIO:8080
VITE_EVOLUTION_API_KEY=tu_apikey_de_evolution
VITE_EVOLUTION_INSTANCE=ad-clinic

